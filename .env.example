# Copy to playwright.env and fill in.
#
#   cp .env.example playwright.env
#
# LANDINGPAGE_URL can be derived instead of typed:
#   export LANDINGPAGE_URL=$(./scripts/env-url.sh test2)

# --- always required -------------------------------------------------------
KEYCLOAK_USER=
KEYCLOAK_PWD=

# Which deployment to test. Prefer scripts/env-url.sh over hardcoding.
LANDINGPAGE_URL=https://test2.theia-test.artemis.cit.tum.de

# --- Artemis integration tests only ----------------------------------------
ARTEMIS_URL=https://artemis-test9.artemis.cit.tum.de
ARTEMIS_USER=
ARTEMIS_PWD=

# --- scale tests only ------------------------------------------------------
# Artillery and the scale project refuse to start without this. One Chromium
# process per virtual user, so the practical ceiling is the runner, not the
# cluster.
NUM_INSTANCES=5
LOAD_TIMEOUT=5000
DETERMINISTIC=1

# --- local IDE instances (--project=local) ---------------------------------
LOCAL_URL_C=https://localhost:3030
LOCAL_URL_JAVA=https://localhost:3031
LOCAL_URL_PYTHON=https://localhost:3032
LOCAL_URL_OCAML=https://localhost:3033
LOCAL_URL_RUST=https://localhost:3034
LOCAL_URL_JS=https://localhost:3035

# --- optional --------------------------------------------------------------
# Show the browser. Off by default; CI runners have no display.
# HEADED=true
# Skip Keycloak entirely (unauthenticated or local instances).
# DISABLE_AUTH=1
