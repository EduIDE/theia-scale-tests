KEYCLOAK_USER=                                              # Username for Keycloak
KEYCLOAK_PWD=                                               # Password for Keycloak

LANDINGPAGE_URL=https://theia.artemis.cit.tum.de            # URL of deployed Theia Landing Page
ARTEMIS_URL=https://artemis-test9.artemis.cit.tum.de        # URL of the Artemis instance that is tested
ARTEMIS_USER=                                               # Test User for Artemis with Course priviliges
ARTEMIS_PWD=                                                # Password of Artemis Test User

NUM_INSTANCES=10                                            # Number of instances for scaled testing
LOAD_TIMEOUT=5000                                           # Amount of time each virtual student runs in seconds
DETERMINISTIC=1                                             # Whether a deterministic workflow should be used in the load tests / 0 false, 1 true

# Benchmark mode (test3 Playwright-only LS measurements)
BENCH_ARCH=internal                                         # internal | external
BENCH_RUNS=30                                               # Number of benchmark runs per architecture/mode
BENCH_TARGET_APP=java-17                                    # Landing page appDefinition to launch (e.g., java-17, java-17-no-ls)
BENCH_OUTPUT_DIR=test-data/benchmark                        # Output directory for raw and aggregated benchmark artifacts
BENCH_FIXED_FILE=src/de/BubbleSort.java                     # Deterministic file path used for syntax-error probes
BENCH_HELPER_FILE=src/bench/BenchHelper.java                # Helper file path used for semantic and hover scenarios
BENCH_MODE=cold                                             # cold | warm
BENCH_SCENARIO=simple-type-error                            # simple-type-error | import-semantic-error | hover-context
BENCH_PROBES=20                                             # Number of deterministic warm probes per run
BENCH_PROBE_TIMEOUT_MS=15000                                # Timeout per probe in milliseconds
BENCH_SETUP_TIMEOUT_MS=600000                               # Setup wait timeout (session startup) in milliseconds
BENCH_WARMUP_TIMEOUT_MS=300000                              # Warmup diagnostic appearance timeout in milliseconds
BENCH_WARMUP_NUDGE_AFTER_MS=240000                          # Optional nudge threshold for the first warmup error in milliseconds
BENCH_STABILIZATION_WAIT_MS=5000                            # Extra wait after warmup before measured probe (LS project init)
BENCH_POST_ERROR_SETTLE_MS=2000                             # Extra wait after diagnostics appear before the next benchmark step
BENCH_HOVER_WARMUP_MS=45000                                 # Fixed warmup wait before hover measurements begin
BENCH_HOVER_RESOLVE_TIMEOUT_MS=15000                        # Hover timeout until real content appears (Loading... does not count)
BENCH_DEBUG_LOG=0                                            # 1 enables step-by-step debug logs to console + file
BENCH_DEBUG_LOG_FILE=test-data/debug/playwright-debug.log    # Relative path for debug log file output

# Beware of no trailing '/' on any URLs
LOCAL_URL_C=https://localhost:3030                          # URL of local Theia C Instance
LOCAL_URL_JAVA=https://localhost:3031                       # URL of local Theia Java Instance
LOCAL_URL_PYTHON=https://localhost:3032                     # URL of local Theia Python Instance
LOCAL_URL_OCAML=https://localhost:3033                      # URL of local Theia OCaml Instance
LOCAL_URL_RUST=https://localhost:3034                       # URL of local Theia Rust Instance
LOCAL_URL_JS=https://localhost:3035                         # URL of local Theia JS Instance
